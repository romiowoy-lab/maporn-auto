    {
      "source": "/:path+/",
      "destination": "/:path+",
      "internal": true,
      "priority": true,
      "statusCode": 308,
      "regex": "^(?:/((?:[^/]+?)(?:/(?:[^/]+?))*))/$"
    },
    {
      "source": "/branches/minburi",
      "destination": "/branches/suzy-fix",
      "statusCode": 308,
      "regex": "^(?!/_next)/branches/minburi(?:/)?$"
    },
    {
      "source": "/news",
      "destination": "/blog",
      "statusCode": 308,
      "regex": "^(?!/_next)/news(?:/)?$"
    },
    {
      "source": "/news/:slug",
      "destination": "/blog/:slug",
      "statusCode": 308,
      "regex": "^(?!/_next)/news(?:/([^/]+?))(?:/)?$"
    }
  ],
