นทางไกลหรือมีเวลาจำกัด แต่การใช้งานบ่อยครั้งอาจทำให้แบตเตอรี่ได้รับความร้อนสะสมมากกว่าการชาร์จแบบ AC ดังนั้นหากเป็นการใช้งานประจำวัน การชาร์จแบบ AC ที่บ้านหรือที่ทำงานจะช่วยถนอมแบตเตอรี่ได้ดีกว่า"}],"$L21","$L22","$L23","$L24","$L25","$L26","$L27","$L28","$L29","$L2a","$L2b","$L2c","$L2d","$L2e","$L2f","$L30","$L31","$L32","$L33","$L34","$L35","$L36","$L37","$L38"]}],false,"$L39","$undefined"]}],"$L3a"]}]}],["$L3b"],"$L3c"]}]
