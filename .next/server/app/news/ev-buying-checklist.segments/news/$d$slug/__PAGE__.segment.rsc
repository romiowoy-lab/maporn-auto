่ เพราะหากต้องรอนำเข้า ระยะเวลาซ่อมจะนานกว่ารถสันดาป"}],"$L21","$L22","$L23","$L24","$L25","$L26","$L27","$L28","$L29","$L2a","$L2b","$L2c","$L2d","$L2e","$L2f"]}],false,"$L30","$undefined"]}],"$L31"]}]}],["$L32"],"$L33"]}]
