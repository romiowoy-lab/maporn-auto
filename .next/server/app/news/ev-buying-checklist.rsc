dth":2.5}],["$","line",null,{"x1":"120","y1":"39","x2":"120","y2":"49","stroke":"currentColor","strokeWidth":2.5}]]}],["$","div",null,{"className":"relative z-10 p-4 sm:p-5 text-white","children":[["$","p",null,{"className":"text-base sm:text-lg font-bold leading-tight","children":"รถยนต์ไฟฟ้า"}],"$undefined"]}]]}],["$","div",null,{"className":"space-y-5","children":[["$","p","0",{"className":"text-base leading-[1.85] text-white/75","children":"รถยนต์ไฟฟ้าในประเทศไทยมีตัวเลือกมากขึ้นทุกปี หลายแบรนด์และหลายรุ่น บางคนเริ่มตัดสินใจจากราคาหรือดีไซน์ แต่การซื้อรถ EV ครั้งแรกมีปัจจัยที่ควรตรวจสอบให้ครบก่อนจอง เพราะค่าใช้จ่ายหลังการซื้อ เช่น ค่าชาร์จ ค่าอะไหล่ และบริการหลังการขาย อาจแตกต่างกันมากในแต่ละแบรนด์"}],["$","h2","1",{"className":"pt-6 text-xl font-bold text-white sm:text-2xl","children":"เช็กลิสต์ 8 ข้อก่อนจองรถ EV"}],["$","p","2",{"className":"text-base leading-[1.85] text-white/75","children":"ข้อ 1 — ศูนย์บริการอยู่ใกล้บ้านหรือที่ทำงานหรือไม่? รถ EV ต้องการช่างที่ผ่านการอบรมเฉพาะและเครื่องมือที่รองรับระบบไฟฟ้าแรงสูง ศูนย์บริการที่ใกล้ที่สุดจึงสำคัญกว่าที่คิด ตรวจสอบรายชื่อและที่ตั้งศูนย์บริการก่อนตัดสินใจซื้อ"}],["$","p","3",{"className":"text-base leading-[1.85] text-white/75","children":"ข้อ 2 — ระยะวิ่งต่อการชาร์จเต็มรองรับการใช้งานจริงของคุณหรือไม่? ระยะวิ่งที่ระบุในสเปคมักเป็นค่าที่ทดสอบในสภาวะอุดมคติ ระยะวิ่งจริงอาจต่างกันตามการใช้แอร์ น้ำหนักบรรทุก และสภาพถนน ควรประมาณระยะทางที่ใช้จริงต่อวันและเทียบกับสเปคของรถ"}],["$","p","4",{"className":"text-base leading-[1.85] text-white/75","children":"ข้อ 3 — เงื่อนไขรับประกันแบตเตอรี่เป็นอย่างไร? แต่ละแบรนด์กำหนดทั้งระยะเวลา ระยะทาง และเกณฑ์ประสิทธิภาพขั้นต่ำของแบตเตอรี่ที่แตกต่างกัน ควรอ่านเงื่อนไขจากเอกสารรับประกันจริงก่อนจอง ไม่ใช่ดูแค่ตัวเลขที่โฆษณา"}],["$","p","5",{"className":"text-base leading-[1.85] text-white/75","children":"ข้อ 4 — อะไหล่และชิ้นส่วนสำรองหาได้ง่ายแค่ไหน? รถ EV มีชิ้นส่วนเฉพาะที่ต้องนำเข้า ตรวจสอบว่าแบรนด์ที่สนใจมีคลังอะไหล่ในประเทศและกระจายถึงสาขาภูมิภาคหรือไม่ เพราะหากต้องรอนำเข้า ระยะเวลาซ่อมจะนานกว่ารถสันดาป"}],"$L27","$L28","$L29","$L2a","$L2b","$L2c","$L2d","$L2e","$L2f","$L30","$L31","$L32","$L33","$L34","$L35"]}],false,"$L36","$undefined"]}],"$L37"]}]}]
